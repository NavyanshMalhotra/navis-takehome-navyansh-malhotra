# ==============================================================================
# Nevis Forward Deployed Engineer (FDE) Agentic Pipeline Configuration
# ==============================================================================

# LLM Provider Configuration
# Set your Gemini API key to enable live LLM reasoning.
# If left empty or unset, the pipeline runs using calibrated deterministic agent fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Alternative Provider (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Pipeline Confidence Thresholds
CONFIDENCE_HIGH_THRESHOLD=0.85
CONFIDENCE_LOW_THRESHOLD=0.50

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# File Paths (relative to repo root)
SOURCES_DIR=nevis-fde-hometask/sources
OUTPUTS_DIR=outputs
