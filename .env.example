# ==============================================================================
# Nevis Forward Deployed Engineer (FDE) Agentic Pipeline Configuration
# ==============================================================================

# Google Gemini API Key
# Supplying this key enables live agentic reasoning with Google Gemini models.
# If left empty, the pipeline executes out-of-the-box using the calibrated agent fallback.
GEMINI_API_KEY=

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# File Paths (relative to repository root)
SOURCES_DIR=nevis-fde-hometask/sources
OUTPUTS_DIR=outputs
